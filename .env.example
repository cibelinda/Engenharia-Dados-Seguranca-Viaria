# Opcional: copie para .env só se quiser trocar algum valor padrão.
# O .env não é versionado.

# PostgreSQL (docker-compose.yml)
POSTGRES_DB=blackspot
POSTGRES_USER=blackspot
POSTGRES_PASSWORD=blackspot
POSTGRES_PORT=5432

# Downloader (blackspot/download.py)
BLACKSPOT_RAW_DIR=data/raw
BLACKSPOT_DOWNLOAD_JOBS=4
